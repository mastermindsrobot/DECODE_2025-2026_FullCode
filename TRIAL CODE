   @Override
   public void loop() {


   /*
    =========================================================
    LOOP EXECUTION MAP
    ---------------------------------------------------------
    1. Pedro follower update
    2. Shooter velocity calculation
    3. Auto path state check
    4. IMU heading update
    5. Gamepad button controls
    6. Joystick input processing
    7. Limelight auto-aim adjustment
    8. Field-centric transform
    9. Mecanum drive power
    10. Intake control
    11. Booster control
    12. Telemetry output
    =========================================================
   */


       // =====================================================
       // PEDRO FOLLOWER UPDATE
       // =====================================================
       follower.update(); // ALWAYS FIRST




       // =====================================================
       // SHOOTER VELOCITY CALCULATION
       // =====================================================


       double Tx = Math.hypot((0-follower.getPose().getX())*0.0254, (0-follower.getPose().getY())*0.0254);


       //double equationthing = (Tx/Math.cos(a)) * Math.sqrt((g)/(2.0*Tx*Math.tan(a)-2.0*Ty));


       // double TARGET_VELOCIT = 2 * 1.2 * - (equationthing / (Math.PI * 0.096)) * 28.0;


      /* TARGET_VELOCITY = VelocityFinderRed.findTargetVelocity(
               follower.getPose().getX(),
               follower.getPose().getY()
       );*/


       telemetry.addData("Target Velocity",TARGET_VELOCITY);
       telemetry.addData("isManualOverrideEnabled ", isManualOverrideEnabled);


       if(isManualOverrideEnabled) {
           // shooter.setVelocity(manualOverrideTargetTPS);
           // shooter2.setVelocity(manualOverrideTargetTPS);
           isManualOverrideFarEnabled = false;
       }
       if(isManualOverrideFarEnabled)
       {
           //  shooter.setVelocity(manualOverrideFarTargetTPS);
           // shooter2.setVelocity(manualOverrideFarTargetTPS);
           isManualOverrideEnabled = false;
       }


       if(!isManualOverrideEnabled && !isManualOverrideFarEnabled)
       {
           shooter.setVelocity(TARGET_VELOCITY);
           shooter2.setVelocity(TARGET_VELOCITY);
       }
       frontIntake.setPower(-1);


       pidf = new PIDFCoefficients(kP, kI, kD, kF);
       shooter.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER, pidf);
       shooter2.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER, pidf);




       // =====================================================
       // AUTO PATHING STATE CHECK
       // =====================================================


       if (autoActive && !follower.isBusy()) {
           autoActive = false;
       }




       // =====================================================
       // ROBOT HEADING (IMU)
       // =====================================================


       double heading = -imu.getRobotYawPitchRollAngles().getYaw(AngleUnit.DEGREES);
       heading = wrapTo180(heading);




       // =====================================================
       // GAMEPAD CONTROLS
       // =====================================================


       if (gamepad1.y && !lastY1) imu.resetYaw();
       lastY1 = gamepad1.y;


       if (gamepad1.a && !lastX1) {
           limelightLock = !limelightLock;
       }
       lastX1 = gamepad1.a;


       if (gamepad1.x){
           isManualOverrideEnabled = true;
           // shooter.setVelocity(manualOverrideTargetTPS);
           // shooter2.setVelocity(manualOverrideTargetTPS);
           //  follower.deactivateAllPIDFs();
           telemetry.addData("PIDF deactivated at close launch ", isManualOverrideEnabled);
       }


       if(gamepad1.b){
           isManualOverrideFarEnabled = true;
           // shooter.setVelocity(manualOverrideFarTargetTPS);
           //  shooter2.setVelocity(manualOverrideFarTargetTPS);
       }




       // =====================================================
       // JOYSTICK INPUT PROCESSING
       // =====================================================


       double rawY  = applyDeadzone(-gamepad1.right_stick_y);
       double rawX  = applyDeadzone(gamepad1.right_stick_x);
       double rawRx = applyDeadzone(gamepad1.left_stick_x);


       double y  = Math.copySign(rawY * rawY, rawY);
       double x  = Math.copySign(rawX * rawX, rawX) * 1.1;
       double rx = Math.copySign(rawRx * rawRx, rawRx);


       // =====================================================
// LIMELIGHT AUTO AIM
// =====================================================


       if (limelightLock) {
           rx += getLimelightRotation();
       }




       // =====================================================
       // GEOMETRY AUTO AIM
       // =====================================================


       if (autoAimLock) {
           double targetHeadingDeg = getGoalHeadingDegrees(follower.getPose().getX(), follower.getPose().getY());
           double headingErrorDeg = wrapTo180(targetHeadingDeg - heading);
           double autoAimTurn = clamp(headingErrorDeg * AUTO_AIM_KP, -AUTO_AIM_MAX_ROT, AUTO_AIM_MAX_ROT);
           rx = autoAimTurn;


           telemetry.addData("Auto Aim Target (deg)", targetHeadingDeg);
           telemetry.addData("Auto Aim Error (deg)", headingErrorDeg);
       }




       // =====================================================
       // FIELD CENTRIC TRANSFORM
       // =====================================================


       double rotatedX = x * Math.cos(Math.toRadians(heading)) - y * Math.sin(Math.toRadians(heading));
       double rotatedY = x * Math.sin(Math.toRadians(heading)) + y * Math.cos(Math.toRadians(heading));




       // =====================================================
       // MECANUM DRIVE
       // =====================================================


       double denominator = Math.max(Math.abs(rotatedY) + Math.abs(rotatedX) + Math.abs(rx), 1.0);


       leftFront.setPower((rotatedY + rotatedX + rx) / denominator * driveSpeed);
       leftBack.setPower((rotatedY - rotatedX + rx) / denominator * driveSpeed);
       rightFront.setPower((rotatedY - rotatedX - rx) / denominator * driveSpeed);
       rightBack.setPower((rotatedY + rotatedX - rx) / denominator * driveSpeed);




       // =====================================================
       // INTAKE CONTROL
       // =====================================================


       boolean lt = gamepad1.left_bumper;


       if (gamepad1.left_trigger > 0.5){
           frontIntake.setPower(1);
           ;}


       if (gamepad1.left_bumper){
           frontIntake.setPower(-1);
       }


       if (!gamepad1.left_bumper && frontIntake.getPower() > 0){
           frontIntake.setPower(0);
       }


       if (gamepad1.right_bumper && !lastDriveSpeedToggle)
           driveSpeed = (driveSpeed == 1.0) ? 0.3 : 1.0;
       lastDriveSpeedToggle = gamepad1.right_bumper;




       // =====================================================
       // BOOSTER CONTROL
       // =====================================================


       long now = System.currentTimeMillis();
       telemetry.addData("Right Bumper", gamepad2.right_bumper);


       // 1. Trigger the 3-second window when the button is pressed
      /* if(gamepad2.rightBumperWasPressed()) {
           if(isManualOverrideEnabled) {
               shooter.setVelocity(manualOverrideTargetTPS);
               shooter2.setVelocity(manualOverrideTargetTPS);
           }


           // Set the end time to 3000 milliseconds (3 seconds) from "now"
           boosterEndTime = System.currentTimeMillis() + 3000;
       }*/


// Optional: Keep your telemetry for shooter status
       if(System.currentTimeMillis() < boosterEndTime) {
           telemetry.addData("Target Velocity set to ", TARGET_VELOCITY);
           telemetry.addData("Shooter Actual Velocity ", shooter.getVelocity());
           telemetry.addData("X", follower.getPose().getX());
           telemetry.addData("Y", follower.getPose().getY());
       }


       boolean detected = laserInput.getState();


       if(!detected){
           booster.setVelocity(-100);
           telemetry.addData("detected", detected);
       }


       if(detected && !gamepad2.right_bumper){
           booster.setVelocity(0);
           shoot_ready = true;
           telemetry.addData("shoot_ready status", shoot_ready);
       } else {
           booster.setVelocity(boosterVelocity);
       }


       if(gamepad2.b){
           boosterEndTime = System.currentTimeMillis() + 3000;
           if (System.currentTimeMillis() < boosterEndTime) {
               // We are still within the 3-second window
               booster.setVelocity(boosterVelocity);


               // Telemetry inside the active window
               telemetry.addData("Booster Status", "Running for 3 seconds...");
               telemetry.addData("Time Remaining", (boosterEndTime - System.currentTimeMillis()) / 1000.0);
           } else {
               // 3 seconds have passed, or button wasn't pressed yet
               booster.setVelocity(0);
               shoot_ready = false;


           }
       }






       // =====================================================
       // TELEMETRY
       // =====================================================


       telemetry.addData("X", follower.getPose().getX());
       telemetry.addData("Y", follower.getPose().getY());
       telemetry.addData("Heading",
               Math.toDegrees(follower.getPose().getHeading()));
       telemetry.addData("Shooter1 Velocity", shooter.getVelocity());
       telemetry.addData("Shooter2 Velocity", shooter2.getVelocity());
       telemetry.addData("Auto Active", autoActive);
       telemetry.addData("Auto Aim Enabled", autoAimLock);
       telemetry.addData("Limelight Lock", limelightLock);
       telemetry.addData("Target Tag", TARGET_TAG_ID);
       telemetry.update();
      // return Tx;
   }


   // =========================================================
   // PEDRO ROTATE
   // =========================================================


   private void rotateToHeading(double targetHeadingDeg) {


       Pose start = follower.getPose();


       Pose end = new Pose(
               start.getX() + 0.1,
               start.getY(),
               start.getHeading()
       );


       PathChain rotatePath = follower.pathBuilder()
               .addPath(new BezierLine(start, end))
               .setConstantHeadingInterpolation(
                       Math.toRadians(targetHeadingDeg)
               )
               .build();


       follower.followPath(rotatePath, true);
   }


   // =========================================================
   // MOVE TO PRESET
   // =========================================================


   private void moveToPreset(Preset preset) {


       currentPath = follower.pathBuilder()
               .addPath(new BezierLine(
                       follower.getPose(),
                       preset.pose
               ))
               .setConstantHeadingInterpolation(
                       Math.toRadians(preset.headingDeg)
               )
               .build();


       follower.followPath(currentPath, true);
   }


   // =========================================================
   // HELPERS
   // =========================================================


   private double applyDeadzone(double value){
       return Math.abs(value) > STICK_DEADZONE ? value : 0.0;
   }


   private double getGoalHeadingDegrees(double robotX, double robotY) {
       // x: forward/back, y: left/right (mirrored field system)
       double deltaX = GOAL_X - robotX;
       double deltaY = GOAL_Y - robotY;
       return Math.toDegrees(Math.atan2(deltaY, deltaX));
   }


   private double clamp(double value, double min, double max) {
       return Math.max(min, Math.min(max, value));
   }


   private Preset findClosestPreset(Pose currentPose){


       Preset closest = null;
       double bestDist = Double.MAX_VALUE;


       for(Preset p : presets){


           double dx = currentPose.getX() - p.pose.getX();
           double dy = currentPose.getY() - p.pose.getY();
           double dist = Math.hypot(dx, dy);


           if(dist < bestDist){
               bestDist = dist;
               closest = p;
           }
       }


       return closest;
   }


   private double wrapTo180(double angle) {


       angle %= 360.0;
       if (angle >= 180) angle -= 360;
       if (angle < -180) angle += 360;


       return angle;
   }


   // =========================================================
// LIMELIGHT AUTO AIM ROTATION
// =========================================================
   private double getLimelightRotation() {
       LLResult result = limelight.getLatestResult();
       if (result == null || !result.isValid()) return 0.0;


       for (LLResultTypes.FiducialResult tag : result.getFiducialResults()) {
           if (tag.getFiducialId() == TARGET_TAG_ID) {
               double tx = result.getTx() + 3;
               telemetry.addData("tx", result.getTx());
               if (Math.abs(tx) < TX_DEADZONE) return 0.0;
               double rot = tx * LL_KP_ROT;
               return Math.max(-LL_ROT_MAX, Math.min(LL_ROT_MAX, rot));
           }
       }
       return 0.0;


   }
